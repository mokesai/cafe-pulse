[Unit]
# Cafe Pulse KDS — sway compositor as a systemd user service.
#
# MOK-49 / MOK-50 (KDS Pi Deployment phase 8).
#
# Installed at ~/.config/systemd/user/kds-kiosk.service by the curl-bash
# setup flow. After install, the setup script runs:
#
#   sudo loginctl enable-linger pi
#   systemctl --user daemon-reload
#   systemctl --user enable kds-kiosk.service
#
# Linger lets the pi-user systemd instance start at boot without an
# interactive login, so the kiosk comes up automatically. Replaces the
# v2-era `.bash_profile` + `startx` autostart that required console
# autologin.

Description=KDS Kiosk (sway Wayland compositor)
After=graphical-session-pre.target seatd.service
Wants=seatd.service

[Service]
Type=simple
# Sway reads its config from ~/.config/sway/config (the same file the
# setup script writes). Running it under systemd gives us free restarts,
# journal logging, and Wants/After ordering.
ExecStart=/usr/bin/sway --config %h/.config/sway/config

# If sway crashes (rare; usually a Chromium-side issue), bring it back up
# after a short pause. Indefinite Restart= would mask config errors —
# RestartSec=3 with StartLimitBurst gives the operator a chance to spot
# a config bug via `journalctl --user -u kds-kiosk -f`.
Restart=on-failure
RestartSec=3
StartLimitBurst=5
StartLimitIntervalSec=60

# XDG_RUNTIME_DIR is normally set by pam_systemd when the user logs in.
# We're running pre-login (linger), so set it explicitly. %U expands to
# the user UID (1000 for default pi user).
Environment=XDG_RUNTIME_DIR=/run/user/%U
# Tell Chromium-under-Wayland which compositor to attach to.
Environment=WAYLAND_DISPLAY=wayland-1
# Pi's Chromium expects this for hardware video acceleration.
Environment=MOZ_ENABLE_WAYLAND=1

# StandardOutput/Error to journal so `journalctl --user -u kds-kiosk` is
# the one-stop shop for compositor + Chromium output.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
